# JOBFORCE — ejemplo de variables de entorno.
# Copiar a `.env` en la RAÍZ del repo y rellenar los valores reales.
# El `.env` real NUNCA se commitea (está en .gitignore).

NODE_ENV=development
PORT=3001

# Conexión que usa el backend.
# En compose, el host es el nombre del servicio ("postgres").
# En desarrollo local con el override (puerto en localhost), usar 127.0.0.1.
DATABASE_URL=postgres://jobforce:CHANGE_ME@postgres:5432/jobforce

# Credenciales con las que el contenedor postgres crea el usuario y la base de datos.
POSTGRES_USER=jobforce
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jobforce

# true en producción (detrás de HTTPS); false en desarrollo local.
# Si se omite, vale true automáticamente cuando NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# Duración de la sesión en horas.
SESSION_TTL_HOURS=24

# Rate limit del login por IP (opcionales; valores de producción por defecto).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Clave de cifrado de secretos en reposo (Fase 5, Gmail OAuth): 32 bytes en
# base64 o hexadecimal. OBLIGATORIA para guardar/leer secretos (credenciales
# OAuth del panel, refresh_token de Gmail). Generar con:
#   openssl rand -base64 32
# El valor real vive solo en el servidor; aquí solo el nombre.
SECRETS_ENCRYPTION_KEY=

# OAuth de Google (Fase 5). Opcionales: el panel puede guardar client_id y
# client_secret cifrados desde /configuracion (tienen prioridad sobre estas
# variables). GOOGLE_REDIRECT_URI tiene por defecto la URI pública del
# despliegue Oracle (la que se registra en Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jpecina.duckdns.org/jobforce/api/integraciones/gmail/callback
