{
  "dependencies": {
    "@jobforce/autonomy": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@jobforce/config": "workspace:*",
    "@jobforce/database": "workspace:*",
    "@jobforce/domain": "workspace:*",
    "@jobforce/eval": "workspace:*",
    "@jobforce/search": "workspace:*",
